    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
