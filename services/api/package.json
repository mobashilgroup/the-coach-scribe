{
  "name": "@tcs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Coach Scribe — coach & client-portal API.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
