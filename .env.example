# =============================================================================
# The Coach Scribe — environment example (NO real secrets here).
# Copy to `.env` and fill values. `.env` is git-ignored.
# Secrets NEVER belong in any frontend bundle (Flutter assets, web JS, HTML).
# =============================================================================

# --- Runtime ---------------------------------------------------------------
APP_ENV=development                 # development | staging | production
PORT=4000
APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3001
API_URL=http://localhost:4000

# --- Database & queues -----------------------------------------------------
DATABASE_URL=postgresql://tcs:tcs@localhost:5432/tcs?schema=public
REDIS_URL=redis://localhost:6379

# --- Object storage (S3 compatible) ---------------------------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=coach-scribe-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto

# --- Auth / crypto ---------------------------------------------------------
# JWT uses an HS256 secret in dev; swap for RS256 key pair in production.
JWT_SECRET=change-me-in-local-only-min-32-chars-long-000
JWT_ACCESS_TTL=900                  # seconds (15 min)
JWT_REFRESH_TTL=2592000             # seconds (30 days)
ENCRYPTION_MASTER_KEY=              # base64, 32 bytes; for OAuth token / file encryption

# --- OAuth -----------------------------------------------------------------
# Google sign-in activates automatically once all three are set (else /oauth
# endpoints return 501). Redirect URI must match the Google console entry.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.thecoachscribe.com/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- AI providers (behind swappable interfaces) ----------------------------
# Set PROVIDER=fake to run the full pipeline with deterministic stubs (default in dev/test).
TRANSCRIPTION_PROVIDER=fake         # fake | deepgram
ANALYSIS_PROVIDER=fake              # fake | openai
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o                 # configurable (Spec §34.7)
DEEPGRAM_MODEL=nova-2               # configurable

# --- Billing ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email / push ----------------------------------------------------------
# In-app notifications always work. Email/push are additive and key-guarded.
EMAIL_PROVIDER=noop                 # noop | sendgrid
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=The Coach Scribe <no-reply@thecoachscribe.com>
PUSH_PROVIDER=noop                  # noop | fcm
FCM_CREDENTIALS=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=

# --- Configurable business defaults (Spec §34) -----------------------------
DEFAULT_RETENTION_DAYS=90           # transcript retention: 30 or 90
AUDIO_DELETE_AFTER_HOURS=24         # delete audio after successful processing
MAX_SESSION_MINUTES=60              # configurable per plan
CONSENT_TEXT_VERSION=v1             # bump when the consent legal text changes
ADMIN_EMAILS=                       # comma-separated emails allowed into /v1/admin/*

# --- Background processing --------------------------------------------------
RETENTION_SWEEP_SECONDS=3600        # retention worker cadence
QUEUE_DRIVER=inline                 # inline | bullmq (bullmq needs REDIS_URL)

# --- Local dev conveniences ------------------------------------------------
STORAGE_DIR=.storage                # local object-storage root (dev only)
# Serve the static coach web app (apps/web_portal) from the API at /app/:
# WEB_DIST_DIR=../../apps/web_portal
